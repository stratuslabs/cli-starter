{
  "name": "@stratuslabs/cli-kit",
  "version": "0.1.0",
  "description": "A polished CLI template: browser login, arrow-key menus, derived help, and scriptable output.",
  "type": "module",
  "bin": {
    "kit": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types --test-timeout=20000 \"test/**/*.test.ts\"",
    "kit": "node --experimental-strip-types src/bin.ts",
    "mock-server": "node --experimental-strip-types scripts/mock-server.ts",
    "rebrand": "node --experimental-strip-types scripts/rebrand.ts"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
